{
	"name": "df_SCD2_Customer",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_Staging_Customer_Parquet",
						"type": "DatasetReference"
					},
					"name": "LakeSource"
				},
				{
					"dataset": {
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference"
					},
					"name": "DimSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference"
					},
					"name": "SinkNewRecords"
				},
				{
					"dataset": {
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference"
					},
					"name": "SinkExpiredRecords"
				}
			],
			"transformations": [
				{
					"name": "AddLakeHash"
				},
				{
					"name": "FilterCurrentDim"
				},
				{
					"name": "ExistsForInsert"
				},
				{
					"name": "AddSCD2Metadata"
				},
				{
					"name": "ExistsForExpiry"
				},
				{
					"name": "AddExpiryMetadata"
				},
				{
					"name": "SetAsUpdate"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CustomerID as integer,",
				"          CustomerName as string,",
				"          Email as string,",
				"          City as string,",
				"          LastModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     wildcardPaths:['customer_extract/*.parquet']) ~> LakeSource",
				"source(output(",
				"          CustomerSK as integer,",
				"          CustomerID as integer,",
				"          CustomerName as string,",
				"          Email as string,",
				"          City as string,",
				"          IsCurrent as boolean,",
				"          EffectiveStartDate as timestamp,",
				"          EffectiveEndDate as timestamp,",
				"          RowHash as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DimSource",
				"LakeSource derive(SourceRowHash = sha2(256, CustomerName, Email, City)) ~> AddLakeHash",
				"DimSource filter(IsCurrent == true()",
				") ~> FilterCurrentDim",
				"AddLakeHash, FilterCurrentDim exists(LakeSource@CustomerID == DimSource@CustomerID",
				"     && SourceRowHash == RowHash,",
				"     negate:true,",
				"     broadcast: 'auto')~> ExistsForInsert",
				"ExistsForInsert derive(IsCurrent = true(),",
				"          EffectiveStartDate = currentTimestamp(),",
				"          EffectiveEndDate = toTimestamp('9999-12-31 00:00:00'),",
				"          RowHash = SourceRowHash) ~> AddSCD2Metadata",
				"FilterCurrentDim, AddLakeHash exists(DimSource@CustomerID == LakeSource@CustomerID && RowHash != SourceRowHash",
				",",
				"     negate:false,",
				"     broadcast: 'right')~> ExistsForExpiry",
				"ExistsForExpiry derive(IsCurrent = false(),",
				"          EffectiveEndDate = currentTimestamp()) ~> AddExpiryMetadata",
				"AddExpiryMetadata alterRow(updateIf(true())) ~> SetAsUpdate",
				"AddSCD2Metadata sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          CustomerID,",
				"          CustomerName,",
				"          Email,",
				"          City,",
				"          IsCurrent,",
				"          EffectiveStartDate,",
				"          EffectiveEndDate,",
				"          RowHash = SourceRowHash",
				"     )) ~> SinkNewRecords",
				"SetAsUpdate sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:true,",
				"     upsertable:false,",
				"     keys:['CustomerSK'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          CustomerSK,",
				"          IsCurrent,",
				"          EffectiveEndDate",
				"     )) ~> SinkExpiredRecords"
			]
		}
	}
}