{
	"name": "Copy_Via_Tool",
	"properties": {
		"activities": [
			{
				"name": "Copy_iu8",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "dbo.SampleCustomers"
					},
					{
						"name": "Destination",
						"value": "customers_cosmos_collection"
					}
				],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"partitionOption": "None"
					},
					"sink": {
						"type": "CosmosDbSqlApiSink",
						"writeBehavior": "insert",
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"enableSkipIncompatibleRow": false,
					"validateDataConsistency": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "CustomerName",
									"type": "String"
								},
								"sink": {
									"path": "$['name']"
								}
							},
							{
								"source": {
									"name": "City",
									"type": "String"
								},
								"sink": {
									"path": "$['location']['city']"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "SourceDataset_iu8",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DestinationDataset_iu8",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-10-06T02:39:10Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}