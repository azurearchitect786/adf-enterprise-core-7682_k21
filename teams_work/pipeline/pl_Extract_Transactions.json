{
	"name": "pl_Extract_Transactions",
	"properties": {
		"activities": [
			{
				"name": "Copy_SQL_to_Lake",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "GetNewMaxWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT CustomerID, CustomerName, Email, City, LastModifiedDate \n FROM dbo.Transactions_Customer \n WHERE LastModifiedDate > ''', activity('GetOldWatermark').output.firstRow.WatermarkValue, ''' \n AND LastModifiedDate <= ''', activity('GetNewMaxWatermark').output.firstRow.NewWatermarkValue, '''')\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"TableName": "Transactions_Customer",
							"SchemaName": "dbo",
							"ds_sql_dbname": "sqldb-enterprise-sink",
							"serverName": "sql-server-etnd-7682"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_Staging_Customer_Parquet",
						"type": "DatasetReference",
						"parameters": {
							"lake_name": "sadlsextng7682"
						}
					}
				]
			},
			{
				"name": "GetOldWatermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "CleanUpStaging",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT WatermarkValue FROM dbo.WatermarkTable WHERE TableName = 'dbo.Transactions_Customer'\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"TableName": "WatermarkTable",
							"SchemaName": "dbo",
							"ds_sql_dbname": "sqldb-enterprise-sink",
							"serverName": "sql-server-etnd-7682"
						}
					}
				}
			},
			{
				"name": "GetNewMaxWatermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "GetOldWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT MAX(LastModifiedDate) as NewWatermarkValue FROM dbo.Transactions_Customer\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"TableName": "Transactions_Customer",
							"SchemaName": "dbo",
							"ds_sql_dbname": "sqldb-enterprise-sink",
							"serverName": "sql-server-etnd-7682"
						}
					}
				}
			},
			{
				"name": "UpdateWatermarkTable",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_SQL_to_Lake",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_UpdateWatermark]",
					"storedProcedureParameters": {
						"NewWatermarkValue": {
							"value": "@activity('GetNewMaxWatermark').output.firstRow.NewWatermarkValue",
							"type": "Datetime"
						},
						"TableName": {
							"value": "dbo.Transactions_Customer",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_Parameterized",
					"type": "LinkedServiceReference",
					"parameters": {
						"DBName": "sqldb-enterprise-sink",
						"ServerName": "sql-server-etnd-7682"
					}
				}
			},
			{
				"name": "Customer_SCD_Type2",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "UpdateWatermarkTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "df_SCD2_Customer",
						"type": "DataFlowReference",
						"datasetParameters": {
							"LakeSource": {
								"lake_name": "sadlsextng7682"
							},
							"DimSource": {
								"TableName": "DimCustomer",
								"SchemaName": "dbo",
								"ds_sql_dbname": "sqldb-enterprise-sink",
								"serverName": "sql-server-etnd-7682"
							},
							"SinkNewRecords": {
								"TableName": "DimCustomer",
								"SchemaName": "dbo",
								"ds_sql_dbname": "sqldb-enterprise-sink",
								"serverName": "sql-server-etnd-7682"
							},
							"SinkExpiredRecords": {
								"TableName": "DimCustomer",
								"SchemaName": "dbo",
								"ds_sql_dbname": "sqldb-enterprise-sink",
								"serverName": "sql-server-etnd-7682"
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "CleanUpStaging",
				"type": "Delete",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_Staging_Customer_Parquet",
						"type": "DatasetReference",
						"parameters": {
							"lake_name": "sadlsextng7682"
						}
					},
					"enableLogging": false,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"wildcardFileName": "*",
						"enablePartitionDiscovery": false
					}
				}
			}
		],
		"annotations": []
	}
}