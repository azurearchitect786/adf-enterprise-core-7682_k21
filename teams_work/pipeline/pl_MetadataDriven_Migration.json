						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT PipelineID, SourceName, SinkCollection, LoadType, WatermarkColumn, CONVERT(varchar(50), WatermarkValue, 121) as WatermarkValue, ColumnMapping FROM DataPipelineControl WHERE IsActive = 1",
